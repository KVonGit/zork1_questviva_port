    <scenery />
    <SYNONYM>BLESSINGS GRACES</SYNONYM>
    <alt type="stringlist">
      <value>graces</value>
    </alt>
    <FLAGS>NDESCBIT</FLAGS>
    <NDESCBIT />
  </object>

  <object name="STAIRS">
    <inherit name="editor_object" />
    <parent type="object">LOCAL_GLOBALS</parent>
    <LOC type="object">LOCAL_GLOBALS</LOC>
    <alias>stairs</alias>
    <scenery />
    <SYNONYM>STAIRS STEPS STAIRCASE STAIRWAY</SYNONYM>
    <ADJECTIVE>STONE DARK MARBLE FORBIDDING STEEP</ADJECTIVE>
    <FLAGS>NDESCBIT CLIMBBIT</FLAGS>
    <NDESCBIT />
    <CLIMBBIT />
    <ACTION>STAIRS_F</ACTION>
  </object>

  <function name="STAIRS_F" type="boolean">
    if (VERB_P(V_THROUGH)) {
      msg ("You should say whether you want to go up or down.")
      return (true)
    }
    return (false)
  </function>

  <object name="SAILOR">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>sailor</alias>
    <scenery />
    <alt type="stringlist">
      <value>footpad</value>
      <value>aviator</value>
    </alt>
    <SYNONYM>SAILOR FOOTPAD AVIATOR</SYNONYM>
    <FLAGS>NDESCBIT</FLAGS>
    <NDESCBIT />
    <ACTION>SAILOR_FCN</ACTION>
  </object>

  <function name="SAILOR_FCN" type="boolean">
    if (VERB_P(V_TELL)) {
      GLOBAL.P_CONT = false
      GLOBAL.QUOTE_FLAG = false
      msg ("You can't talk to the sailor that way.")
      return (true)
    }
    else if (VERB_P(V_EXAMINE)) {
      msg ("There is no sailor to be seen.")
      return (true)
    }
    else if (VERB_P(V_HELLO)) {
      GLOBAL.HS = GLOBAL.HS + 1
      if (GLOBAL.HS % 20 = 0) {
        msg ("You seem to be repeating yourself.")
      }
      else if (GLOBAL.HS % 10 = 0) {
        msg ("I think that phrase is getting a bit worn out.")
      }
      else {
        msg ("Nothing happens here.")
      }
      return (true)
    }
    return (false)
  </function>

  <object name="GROUND">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>ground</alias>
    <alt type="stringlist">
      <value>dirt</value>
      <value>floor</value>
      <value>sand</value>
    </alt>
    <SYNONYM>GROUND SAND DIRT FLOOR</SYNONYM>
    <ACTION>GROUND_FUNCTION</ACTION>
    <scenery />
  </object>

  <function name="GROUND_FUNCTION" type="boolean">
    if (VERB_P(V_PUT) and GLOBAL.PRSI = GROUND) {
      PERFORM (V_DROP, GLOBAL.PRSO, NOTHING)
      return (true)
    }
    else if (GLOBAL.HERE = SANDY_CAVE) {
      return (SandFunction())
    }
    return (false)
  </function>

  <object name="GRUE">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>lurking grue</alias>
    <alt type="stringlist">
      <value>lurking grue</value>
      <value>sinister grue</value>
      <value>hungry grue</value>
      <value>silent grue</value>
    </alt>
    <SYNONYM>GRUE</SYNONYM>
    <ADJECTIVE>LURKING SINISTER HUNGRY SILENT</ADJECTIVE>
    <ACTION>GRUE_FUNCTION</ACTION>
    <scenery />
  </object>

  <function name="GRUE_FUNCTION" type="boolean">
    if (VERB_P(V_EXAMINE)) {
      msg ("The grue is a sinister, lurking presence in the dark places of the earth. Its favorite diet is adventurers, but its insatiable appetite is tempered by its fear of light. No grue has ever been seen by the light of day, and few have survived its fearsome jaws to tell the tale.")
      return (true)
    }
    else if (VERB_P(V_FIND)) {
      msg ("There is no grue here, but I'm sure there is at least one lurking in the darkness nearby. I wouldn't let my light go out if I were you!")
      return (true)
    }
    else if (VERB_P(V_LISTEN)) {
      msg ("It makes no sound but is always lurking in the darkness nearby.")
      return (true)
    }
    return (false)
  </function>

  <object name="LUNGS">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>blast of air</alias>
    <alt type="stringlist">
      <value>lungs</value>
      <value>air</value>
      <value>mouth</value>
      <value>breath</value>
    </alt>
    <scenery />
    <SYNONYM>LUNGS AIR MOUTH BREATH</SYNONYM>
    <FLAGS>NDESCBIT</FLAGS>
    <NDESCBIT />
  </object>

  <object name="ME"> <!-- Quest handles "me" as the POV. -->
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>you</alias>
    <SYNONYM>ME MYSELF SELF CRETIN</SYNONYM>
    <alt type="simplestringlist">
      ME
      MYSELF
      SELF
      CRETIN
    </alt>
    <FLAGS>ACTORBIT</FLAGS>
    <ACTORBIT />
    <ACTION>CRETIN_FCN</ACTION>
    <scenery />
  </object>

  <function name="CRETIN_FCN" type="boolean">
    VERB = GLOBAL.PRSA
    if (VERB_P(V_TELL)) {
      GLOBAL.P_CONT = false
      GLOBAL.QUOTE_FLAG = false
      msg ("Talking to yourself is said to be a sign of impending mental collapse.")
      return (true)
    }
    else if (VERB_P(V_GIVE) and GLOBAL.PRSI = ME) {
      PERFORM (V_TAKE, GLOBAL.PRSO, NOTHING)
      return (true)
    }
    else if (VERB_P(V_MAKE)) {
      msg ("Only you can do that.")
      return (true)
    }
    else if (VERB_P(V_DISEMBARK)) {
      msg ("You'll have to do that on your own.")
      return (true)
    }
    else if (VERB_P(V_EAT)) {
      msg ("Auto-cannibalism is not the answer.")
      return (true)
    }
    else if (VERB_P(V_ATTACK)) {
      if (not GLOBAL.PRSI = NOTHING) {
        if (GLOBAL.PRSI.WEAPONBIT) {
          JIGS_UP ("If you insist.... Poof, you're dead!")
          return (true)
        }
      }
      msg ("Suicide is not the answer.")
      return (true)
    }
    else if (VERB_P(V_THROW)) {
      if (GLOBAL.PRSO = ME) {
        msg ("Why don't you just walk like normal people?")
        return (true)
      }
    }
    else if (VERB_P(V_TAKE)) {
      msg ("How romantic!")
      return (true)
    }
    else if (VERB_P(V_EXAMINE)) {
      if (GLOBAL.HERE = LOC(MIRROR_1) or GLOBAL.HERE = LOC(MIRROR_2)) {
        msg ("Your image in the mirror looks tired.")
      }
      else {
        msg ("That's difficult unless your eyes are prehensile.")
      }
      return (true)
    }
    return (false)
  </function>

  <object name="ADVENTURER">
    <inherit name="editor_object" />
    <!--Game won't load without setting this object's parent first. -->
    <parent type="object">WEST_OF_HOUSE</parent> 
    <LOC type="object">WEST_OF_HOUSE</LOC>
    <alias>cretin</alias>
    <changedalias type="script">
      Log("changed ADVENTURER alias! Resetting to 'cretin'.")
      ADVENTURER.alias = "cretin"
    </changedalias>
    <scenery />
    <visible type="boolean">false</visible>
    <SYNONYM>ADVENTURER</SYNONYM>
    <FLAGS>NDESCBIT INVISIBLE SACREDBIT ACTORBIT</FLAGS>
    <NDESCBIT />
    <INVISIBLE />
    <SACREDBIT />
    <ACTORBIT />
    <STRENGTH type="int">0</STRENGTH>
    <!-- <ACTION type="int">0</ACTION> -->
  </object>

  <object name="PATHOBJ">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>passage</alias>
    <scenery />
    <SYNONYM>TRAIL PATH</SYNONYM>
    <ADJECTIVE>FOREST NARROW LONG WINDING</ADJECTIVE>
    <alt type="stringlist">
      <value>trail</value>
      <value>path</value>
    </alt>
    <FLAGS>NDESCBIT</FLAGS>
    <NDESCBIT />
    <ACTION>PATH_OBJECT</ACTION>
  </object>

  <function name="PATH_OBJECT" type="boolean">
    if (VERB_P(V_TAKE) or VERB_P(V_FOLLOW)) {
      msg ("You must specify a direction to go.")
      return (true)
    }
    else if (VERB_P(V_FIND)) {
      msg ("I can't help you there....")
      return (true)
    }
    else if (VERB_P(V_DIG)) {
      msg ("Not a chance.")
      return (true)
    }
    return (false)
  </function>

  <object name="ZORKMID">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
