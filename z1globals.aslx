      <value type="string">* IN OBJECT = V_SEARCH</value>
      <value type="string">* FOR OBJECT = V_SEND</value>
      <value type="string">* OBJECT (HAVE) = V_SHAKE</value>
      <value type="string">*  = V_SKIP</value>
      <value type="string">* OBJECT = V_SMELL</value>
      <value type="string">* OBJECT = V_SPIN</value>
      <value type="string">* OBJECT ON OBJECT = V_SPRAY</value>
      <value type="string">* OBJECT WITH OBJECT = V_SSPRAY</value>
      <value type="string">* OBJECT = V_SQUEEZE</value>
      <value type="string">*  = V_STAND</value>
      <value type="string">* UP OBJECT (FIND RMUNGBIT) = V_STAND</value>
      <value type="string">*  = V_STAY</value>
      <value type="string">* OBJECT (ON_GROUND IN_ROOM HELD CARRIED) = V_STRIKE</value>
      <value type="string">*  = V_SWIM</value>
      <value type="string">* IN OBJECT = V_SWIM</value>
      <value type="string">* ACROSS OBJECT = V_SWIM</value>
      <value type="string">* OBJECT (FIND WEAPONBIT) (HELD CARRIED HAVE) = V_SWING</value>
      <value type="string">* OBJECT (FIND WEAPONBIT) (HELD CARRIED HAVE) AT OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) = V_SWING</value>
      <value type="string">* OBJECT (HELD CARRIED HAVE) AT OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) = V_THROW</value>
      <value type="string">* OBJECT (HELD CARRIED HAVE) WITH OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) = V_THROW</value>
      <value type="string">* OBJECT (HELD CARRIED HAVE) OFF OBJECT = V_THROW_OFF</value>
      <value type="string">* OBJECT (HELD CARRIED HAVE) OVER OBJECT = V_THROW_OFF</value>
      <value type="string">* OBJECT TO OBJECT = V_TIE</value>
      <value type="string">* UP OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) WITH OBJECT (FIND TOOLBIT) (ON_GROUND IN_ROOM HELD CARRIED HAVE) = V_TIE_UP</value>
      <value type="string">*  = V_TREASURE</value>
      <value type="string">* OBJECT (ON_GROUND IN_ROOM) WITH OBJECT (FIND TOOLBIT) (HELD CARRIED ON_GROUND IN_ROOM TAKE) = V_UNLOCK</value>
      <value type="string">* OBJECT (ON_GROUND IN_ROOM HELD CARRIED) = V_UNTIE</value>
      <value type="string">* OBJECT (ON_GROUND IN_ROOM HELD CARRIED) FROM OBJECT = V_UNTIE</value>
      <value type="string">*  = V_WAIT</value>
      <value type="string">* OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) = V_ALARM</value>
      <value type="string">* UP OBJECT (FIND ACTORBIT) (ON_GROUND IN_ROOM) = V_ALARM</value>
      <value type="string">*  = V_WALK_AROUND</value>
      <value type="string">* AROUND OBJECT = V_WALK_AROUND</value>
      <value type="string">* OBJECT = V_WALK</value>
      <value type="string">* AWAY OBJECT = V_WALK</value>
      <value type="string">* TO OBJECT = V_WALK_TO</value>
      <value type="string">* OBJECT (HELD CARRIED TAKE HAVE) = V_WAVE</value>
      <value type="string">* OBJECT (HELD CARRIED TAKE HAVE) AT OBJECT = V_WAVE</value>
      <value type="string">* AT OBJECT = V_WAVE</value>
      <value type="string">* ON OBJECT (IN_ROOM ON_GROUND CARRIED MANY) = V_WEAR</value>
      <value type="string">* OBJECT = V_WEAR</value>
      <value type="string">*  = V_WIN</value>
      <value type="string">* OBJECT = V_WIND</value>
      <value type="string">* UP OBJECT = V_WIND</value>
      <value type="string">*  = V_WISH</value>
      <value type="string">*  = V_YELL</value>
      <value type="string">*  = V_ZORK</value>
      <value type="string">* AT OBJECT (HELD CARRIED ON-GROUND IN-ROOM) WITH OBJECT = V_READ</value>
      <value type="string">* OBJECT (FIND READBIT) (HELD CARRIED ON-GROUND IN-ROOM TAKE) = V_READ</value>
      <value type="string">* FROM OBJECT (FIND READBIT) (HELD CARRIED ON-GROUND IN-ROOM TAKE) = V_READ</value>
      <value type="string">* OBJECT (FIND READBIT) (HELD CARRIED ON-GROUND IN-ROOM TAKE) WITH OBJECT = V_READ</value>
    </attr>
