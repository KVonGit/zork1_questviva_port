  </object>

  <function name="ZORKMID_FUNCTION" type="boolean">
    if (VERB_P(V_EXAMINE)) {
      msg ("The zorkmid is the unit of currency of the Great Underground Empire.")
      return (true)
    }
    else if (VERB_P(V_FIND)) {
      msg ("The best way to find zorkmids is to go out and look for them.")
      return (true)
    }
    return (false)
  </function>

