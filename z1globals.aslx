<?xml version="1.0"?>
<!--
  GLOBALS for ZORK 1
-->
<library>
<!--
    "SUBTITLE GLOBAL OBJECTS"
-->

  <object name="GLOBAL_OBJECTS">
    <FLAGS>RMUNGBIT INVISIBLE TOUCHBIT SURFACEBIT TRYTAKEBIT OPENBIT SEARCHBIT TRANSBIT ONBIT RLANDBIT FIGHTBIT STAGGERED WEARBIT</FLAGS>
    <RMUNGBIT />
    <INVISIBLE />
    <TOUCHBIT />
    <SURFACEBIT />
    <TRYTAKEBIT />
    <OPENBIT />
    <SEARCHBIT />
    <TRANSBIT />
    <ONBIT />
    <RLANDBIT />
    <FIGHTBIT />
    <STAGGERED />
    <WEARBIT />
  </object>

  <object name="LOCAL_GLOBALS">
    <alt type="stringlist">
      <value>ZZMGCK</value>
    </alt>
    <SYNONYM>ZZMGCK</SYNONYM>
    <attr name="DESC_FCN">PATH_OBJECT</attr>
    <GLOBAL>GLOBAL_OBJECTS</GLOBAL>
    <ADVFCN type="int">0</ADVFCN>
    <FDESC>F</FDESC>
    <LDESC>F</LDESC>
    <PSEUDO>"FOOBAR" V_WALK</PSEUDO>
    <CONTFCN type="int">0</CONTFCN>
    <VTYPE type="int">1</VTYPE>
    <SIZE type="int">0</SIZE>
    <CAPACITY type="int">0</CAPACITY>
  </object>

<!--
    ;"Yes, this synonym for LOCAL-GLOBALS needs to exist... sigh"
-->

  <object name="ROOMS">
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <scenery />
    <exit alias="in" to="ROOMS">
      <inherit name="indirection" />
    </exit>
  </object>

  <object name="INTNUM">
    <inherit name="editor_object" />
    <parent type="object">GLOBAL_OBJECTS</parent>
    <LOC type="object">GLOBAL_OBJECTS</LOC>
    <alias>number</alias>
    <alt type="stringlist">
      <value>intnum</value>
    </alt>
    <SYNONYM>INTNUM</SYNONYM>
    <FLAGS>TOOLBIT</FLAGS>
    <TOOLBIT />
    <scenery />
  </object>
  
  <object name="PSEUDO_OBJECT">
    <inherit name="editor_object" />
    <parent type="object">LOCAL_GLOBALS</parent>
    <LOC type="object">LOCAL_GLOBALS</LOC>
    <alias>pseudo</alias>
    <ACTION>CRETIN_FCN</ACTION>
    <scenery />
  </object>

  <object name="IT"> <!-- UNUSED IN THIS PORT -->
    <inherit name="editor_object" />
    <!-- <parent type="object">GLOBAL_OBJECTS</parent> -->
    <!-- <LOC type="object">GLOBAL_OBJECTS</LOC> -->
    <alias>random object</alias>
    <scenery />
    <TOUCHBIT />
    <alt type="stringlist">
      <value>it</value>
      <value>them</value>
      <value>her</value>
      <value>him</value>
    </alt>
    <SYNONYM>IT THEM HER HIM</SYNONYM>
    <FLAGS>NDESCBIT TOUCHBIT</FLAGS>
    <NDESCBIT />
    <visible type="boolean">false</visible>
  </object>
  
  <object name="NOT_HERE_OBJECT">
    <inherit name="editor_object" />
    <alias>such thing</alias>
    <ACTION>NOT_HERE_OBJECT_F</ACTION>
  </object>

  <function name="NOT_HERE_OBJECT_F" type="boolean">
    if (GLOBAL.PRSO = NOT_HERE_OBJECT and GLOBAL.PRSI = NOT_HERE_OBJECT) {
      msg ("Those things aren't here!")
    }
    else if (GLOBAL.PRSO = NOT_HERE_OBJECT) {
      TBL = GLOBAL.P_PRSO
    }
    else {
      TBL = GLOBAL.P_PRSI
      PRSO_P = false
    }
    GLOBAL.P_CONT = false
    GLOBAL.QUOTE_FLAG = false
    if (GLOBAL.WINNER = GLOBAL.PLAYER) {
      TELL ("You can't see any ")
      NOT_HERE_PRINT (PRSO_P)
      msg ("here!")
    }
    else {
      TELL ("The " + GLOBAL.WINNER.alias + " seems confused. \"I don't see any ")
      NOT_HERE_PRINT (PRSO_P)
      msg ("here!\"")
    }
    return (true)
  </function>

  <function name="NOT_HERE_PRINT" parameters="PRSO_P">
    if (GLOBAL.P_OFLAG) {
      if (GLOBAL.P_XADJ) {
        msg (GLOBAL.P_XADJN)
      }
      if (GLOBAL.P_XNAM) {
        msg (GLOBAL.P_XNAM)
      }
    }
    else if (PRSO_P) {
      msg (GET(GLOBAL.P_ITBL, GLOBAL.P_NC1) + GET(GLOBAL.P_ITBLL, GLOBAL.P_NC2L))
    }
  </function>
  
  <function name="NULL_F" parameters="A1, A2" type="boolean">
    if (not IsDefined("A1")) {
      A1 = false
    }
    if (not IsDefined("A2")) {
      A2 = false
    }
    return (false)
  </function>

<!--
    "Objects WHICH WERE ORIGINALLY shared by all three Zorks go here"
-->

<!--
    THESE GLOBALS ARE ATTRIBUTES ON THE GLOBAL OBJECT IN THIS FILE.
    
  <GLOBAL LOAD-MAX 100>

  <GLOBAL LOAD-ALLOWED 100>
-->

