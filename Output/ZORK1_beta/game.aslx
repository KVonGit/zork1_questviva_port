    <listchildren />
    <SYNONYM>EGG TREASURE</SYNONYM>
    <ADJECTIVE>BROKEN BIRDS ENCRUSTED JEWEL</ADJECTIVE>
    <alt type="stringlist">
      <value>treasure</value>
