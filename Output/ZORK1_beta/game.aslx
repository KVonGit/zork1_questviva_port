          <OPENBIT />
          <TRYTAKEBIT />
          <SACREDBIT />
          <ACTION>TOOL_CHEST_FCN</ACTION>
          <attr name="feature_container" type="boolean">true</attr>
          <close type="boolean">false</close>
          <open type="boolean">false</open>
          <LOC type="object">MAINTENANCE_ROOM</LOC>
