          <runscript />
          <CEXIT />
          <script type="script">
            // GRATING_EXIT
            if (GLOBAL.GRATE_REVEALED) {
              if (GRATE.isopen) {
                GOTO (GRATING_ROOM, true)
              }
              else {
                TELL ("The grating is closed!")
                THIS_IS_IT (GRATE)
              }
            }
            else {
              msg (Template("UnresolvedLocation"))
            }
          </script>
        </exit>
