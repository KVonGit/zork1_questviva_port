            <TAKEBIT />
            <FLAMEBIT />
            <ONBIT />
            <LIGHTBIT />
            <ACTION>TORCH_OBJECT</ACTION>
            <FDESC>Sitting on the pedestal is a flaming torch, made of ivory.</FDESC>
            <SIZE type="int">20</SIZE>
            <VALUE type="int">14</VALUE>
            <TVALUE type="int">6</TVALUE>
            <lightstrength>strong</lightstrength>
